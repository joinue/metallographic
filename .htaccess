RedirectMatch 301 (?i)^/metallographic-consumables/Metallography-Zirconia-Grinding-Papers(\.html?)?$ /metallographic-consumables/grinding/abrasive-grinding

# =====================
# LEGACY-URL TECHNICAL ARTICLES — /metallographic-technical/Metallography-Technical-*.htm
# Old PACE technical-articles series; redirect to modern consumables / equipment pages.
# =====================

RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Abrasive-Cutting(\.html?)?$ /metallographic-consumables/sectioning/abrasive-cutting
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Abrasive-Grinding(\.html?)?$ /metallographic-consumables/grinding/abrasive-grinding
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Castable-Mount(\.html?)?$ /metallographic-consumables/mounting/castable
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Cleaning(\.html?)?$ /metallographic-consumables/cleaning
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Compression-Mount(\.html?)?$ /metallographic-consumables/mounting/compression
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Diamond-Disk(\.html?)?$ /metallographic-consumables/grinding/diamond-grinding
# Technical-Etching redirects to /etchants (new etchant hub; 43% body match acceptable)
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Etching(\.html?)?$ /etchants
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Fine-Abrasives(\.html?)?$ /metallographic-consumables/final-polishing
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Hardness(\.html?)?$ /metallographic-consumables/hardness-testing
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Lapping-Films(\.html?)?$ /metallographic-consumables/grinding/lapping-films
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Monocrystalline-Diamond(\.html?)?$ /metallographic-consumables/polishing/monocrystalline-diamond
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Polishing-Magnetic(\.html?)?$ /metallographic-consumables/polishing/magnetic-system
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Polishing-PSA(\.html?)?$ /metallographic-consumables/polishing/polishing-pads
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Polycrystalline-Diamond(\.html?)?$ /metallographic-consumables/polishing/polycrystalline-diamond
RedirectMatch 301 (?i)^/metallographic-technical/Metallography-Technical-Wafer-Cutting(\.html?)?$ /metallographic-consumables/sectioning/precision-wafering

# =====================
# COMPANY HIERARCHY COLLAPSE
# Legacy /company.html + /company/*.html were byte-identical duplicates of
# root pages (about, careers, privacy, terms, support/site-map). Collapsed
# to the canonical roots. /company/docs/ PDFs remain served.
# =====================

RedirectMatch 301 (?i)^/company(\.html?)?$ /about
RedirectMatch 301 (?i)^/company/about(\.html?)?$ /about
RedirectMatch 301 (?i)^/company/careers(\.html?)?$ /careers
RedirectMatch 301 (?i)^/company/privacy(\.html?)?$ /privacy
RedirectMatch 301 (?i)^/company/terms(\.html?)?$ /terms
RedirectMatch 301 (?i)^/company/sitemap(\.html?)?$ /support/site-map

# =====================
# PAGE RENAMES
# =====================

RedirectMatch 301 (?i)^/docs(\.html?)?$ /library
RedirectMatch 301 (?i)^/etchants/4-percent-picral(\.html?)?$ /etchants/picral

# =====================
# CLEAN URLs
# =====================

# Redirect index.html / index.htm to /  (preserves subdirectory: /foo/index.html → /foo/)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html?(\s|\?|$) [NC]
RewriteRule ^ /%1 [R=301,L]

# Strip .html / .htm extension from browser URL (external redirect)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html?(\s|\?|$) [NC]
RewriteRule ^ /%1 [R=301,L]

# Trailing slash — serve .html if the file exists
RewriteRule ^(.+)/$ - [E=BASE:$1]

RewriteCond %{DOCUMENT_ROOT}/%{ENV:BASE}.html -f
RewriteRule ^(.+)/$ /%{ENV:BASE}.html [L]

RewriteCond %{DOCUMENT_ROOT}/%{ENV:BASE}.htm -f
RewriteRule ^(.+)/$ /%{ENV:BASE}.htm [L]

# Extensionless URL — internally serve .html then .htm
RewriteCond %{REQUEST_URI} !\.html?$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

RewriteCond %{REQUEST_URI} !\.htm$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.htm -f
RewriteRule ^(.*)$ $1.htm [L]

# =====================
# ERROR PAGE
# =====================

ErrorDocument 404 /404.html

# =====================
# PERFORMANCE
# =====================

# Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# Brotli — preferred when client supports it; no-op if module unavailable
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# MIME types
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType text/html .html .htm
    AddType text/plain .txt
    AddType image/jpeg .jpg .jpeg
    AddType image/png .png
    AddType image/svg+xml .svg .svgz
    AddType video/mp4 .mp4
    AddType application/pdf .pdf
    AddType application/font-woff .woff
    AddType application/font-woff2 .woff2
</IfModule>

# Caching — max-age only, no hardcoded Expires dates
<IfModule mod_headers.c>
    # Images — 1 year
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # CSS / JS — 2 days (no per-file versioning, so keep it short enough that deploys propagate)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=172800"
    </FilesMatch>

    # Fonts — 1 year
    <FilesMatch "\.(woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # PDF / Video — 1 year
    <FilesMatch "\.(pdf|mp4)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # HTML — 1 hour
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
